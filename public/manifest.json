{
  "manifest_version": 3,
  "name": "Audioforma | YouTube Audio Visualizer",
  "version": "1.1",
  "description": "Analyzes the audio of a YouTube video and overlays visualizations.",
  "browser_specific_settings": {
    "gecko": {
      "id": "audioforma@jaspercroo.me",
      "strict_min_version": "115.0"
    },
    "safari": {
      "strict_min_version": "14"
    }
  },
  "host_permissions": ["*://*/*", "<all_urls>"],
  "permissions": [
    "tabCapture",
    "tabs",
    "activeTab"
  ],
  "commands": {
    "toggle-visual": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "Toggle audio visualization"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon_16.png",
      "32": "icon_32.png",
      "48": "icon_48.png",
      "128": "icon_128.png"
    }
  },
  "options_ui": {
    "page": "options.html"
  },
  "background": {
    "service_worker": "js/background.js"
  }
}
